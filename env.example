import { useState, useEffect } from "react";
import { Play, Pause, RotateCcw, X, ShieldAlert, CheckCircle2 } from "lucide-react";

interface SessionTimerProps {
  focusArea: string;
  timeBlock: string;
  onClose: () => void;
}

export default function SessionTimer({ focusArea, timeBlock, onClose }: SessionTimerProps) {
  // Parse a duration from the time block, or default to 25 minutes
  const [minutes, setMinutes] = useState(25);
  const [seconds, setSeconds] = useState(0);
  const [isActive, setIsActive] = useState(false);
  const [completed, setCompleted] = useState(false);

  useEffect(() => {
    // Try to parse block length from time block, e.g., "14:00 - 14:45" => 45 minutes
    try {
      const parts = timeBlock.split("-");
      if (parts.length === 2) {
        const start = parts[0].trim().split(":");
        const end = parts[1].trim().split(":");
        if (start.length === 2 && end.length === 2) {
          const startMin = parseInt(start[0]) * 60 + parseInt(start[1]);
          const endMin = parseInt(end[0]) * 60 + parseInt(end[1]);
          let diff = endMin - startMin;
          if (diff < 0) diff += 24 * 60; // crossover midnight
          if (diff > 0 && diff <= 120) {
            setMinutes(diff);
          }
        }
      }
    } catch (e) {
      // Fallback to default 25
    }
  }, [timeBlock]);

  useEffect(() => {
    let interval: NodeJS.Timeout | null = null;

    if (isActive) {
      interval = setInterval(() => {
        if (seconds > 0) {
          setSeconds(seconds - 1);
        } else if (minutes > 0) {
          setMinutes(minutes - 1);
          setSeconds(59);
        } else {
          setIsActive(false);
          setCompleted(true);
          playAlertSound();
        }
      }, 1000);
    } else {
      if (interval) clearInterval(interval);
    }

    return () => {
      if (interval) clearInterval(interval);
    };
  }, [isActive, minutes, seconds]);

  const playAlertSound = () => {
    try {
      // Use web audio context for an elegant synth bell chime on completion
      const audioCtx = new (window.AudioContext || (window as any).webkitAudioContext)();
      const osc = audioCtx.createOscillator();
      const gainNode = audioCtx.createGain();
      
      osc.type = "sine";
      osc.frequency.setValueAtTime(523.25, audioCtx.currentTime); // C5
      osc.frequency.setValueAtTime(659.25, audioCtx.currentTime + 0.15); // E5
      osc.frequency.setValueAtTime(783.99, audioCtx.currentTime + 0.3); // G5
      osc.frequency.setValueAtTime(1046.5, audioCtx.currentTime + 0.45); // C6
      
      gainNode.gain.setValueAtTime(0.3, audioCtx.currentTime);
      gainNode.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 1.2);
      
      osc.connect(gainNode);
      gainNode.connect(audioCtx.destination);
      
      osc.start();
      osc.stop(audioCtx.currentTime + 1.5);
    } catch (e) {
      // Fallback gracefully if context is blocked
    }
  };

  const toggleTimer = () => setIsActive(!isActive);

  const resetTimer = () => {
    setIsActive(false);
    setCompleted(false);
    setMinutes(25);
    setSeconds(0);
  };

  const percentLeft = ((minutes * 60 + seconds) / (25 * 60)) * 100;

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center bg-zinc-950/80 backdrop-blur-md p-4 animate-fade-in">
      <div className="bg-zinc-900 border border-sky-500/30 rounded-2xl p-6 max-w-md w-full relative glow-cyan flex flex-col gap-6 text-center">
        {/* Close Button */}
        <button
          onClick={onClose}
          className="absolute top-4 right-4 text-zinc-400 hover:text-zinc-200 hover:bg-zinc-800 p-1.5 rounded-lg transition-all cursor-pointer"
        >
          <X className="h-4 w-4" />
        </button>

        <div>
          <span className="text-[10px] font-mono tracking-widest text-sky-400 border border-sky-500/30 rounded-full px-2.5 py-1 bg-sky-950/20 uppercase">
            Aegis Focus Segment
          </span>
          <h3 className="font-display text-lg font-bold text-zinc-100 mt-4 leading-snug">
            {focusArea}
          </h3>
          <p className="text-xs text-zinc-400 font-mono mt-1">
            Scheduled: {timeBlock}
          </p>
        </div>

        {/* Timer Display */}
        <div className="relative flex items-center justify-center py-6">
          {/* Circular dial background effect */}
          <div className="w-48 h-48 rounded-full border-4 border-zinc-800 flex flex-col items-center justify-center bg-zinc-950/80 relative">
            <div className="font-mono text-4xl font-bold tracking-tight text-zinc-100">
              {String(minutes).padStart(2, "0")}:{String(seconds).padStart(2, "0")}
            </div>
            <div className="text-[10px] font-mono text-zinc-500 tracking-wider uppercase mt-1">
              {isActive ? "SESSION ACTIVE" : completed ? "SEGMENT COMPLETE" : "STANDBY"}
            </div>
          </div>
        </div>

        {/* Status Prompt */}
        {completed ? (
          <div className="flex items-center gap-2 justify-center bg-emerald-950/20 text-emerald-400 border border-emerald-500/20 py-2.5 px-4 rounded-lg">
            <CheckCircle2 className="h-4 w-4" />
            <span className="text-xs font-mono font-medium">Session objective met successfully.</span>
          </div>
        ) : (
          <div className="flex items-center gap-2 justify-center bg-sky-950/10 text-sky-400 border border-sky-500/10 py-2 px-3 rounded-lg text-left">
            <ShieldAlert className="h-4 w-4 flex-shrink-0 animate-pulse" />
            <span className="text-[11px] font-mono leading-relaxed">
              Cognitive shield active. Fullscreen/Iframe distraction lock is recommended. Focus entirely on the segment.
            </span>
          </div>
        )}

        {/* Control Buttons */}
        <div className="flex justify-center items-center gap-4">
          <button
            onClick={toggleTimer}
            disabled={completed}
            className={`flex items-center gap-1.5 px-6 py-2.5 rounded-lg text-xs font-bold font-display uppercase tracking-wider transition-all cursor-pointer ${
              completed
                ? "bg-zinc-800 text-zinc-500 cursor-not-allowed border border-zinc-700"
                : isActive
                ? "bg-amber-500 hover:bg-amber-400 text-zinc-950 border border-amber-400"
                : "bg-sky-500 hover:bg-sky-400 text-zinc-950 border border-sky-400"
            }`}
          >
            {isActive ? (
              <>
                <Pause className="h-4 w-4 fill-current" />
                <span>Pause</span>
              </>
            ) : (
              <>
                <Play className="h-4 w-4 fill-current" />
                <span>Initiate</span>
              </>
            )}
          </button>

          <button
            onClick={resetTimer}
            className="flex items-center gap-1.5 border border-zinc-800 hover:border-zinc-700 bg-zinc-950/60 hover:bg-zinc-800 text-zinc-400 hover:text-zinc-200 px-4 py-2.5 rounded-lg text-xs font-mono uppercase tracking-wider transition-all cursor-pointer"
          >
            <RotateCcw className="h-4 w-4" />
            <span>Reset</span>
          </button>
        </div>
      </div>
    </div>
  );
}
